#!/usr/bin/env python3
# Fetches finished OpenVAS scan reports via the GMP Unix socket and POSTs them
# to the local openvas-tracker instance for import.
#
# Every scan task's last finished report is a candidate, oldest scan_end first.
# Before downloading one, the script asks the tracker (GET /api/import/openvas/check)
# whether to import it: no if a scan already holds that GVM report ID, no if it
# ended before the newest imported report (stale). So overlapping tasks no longer
# hide each other's reports, and a report missed while the import path was broken
# is picked up by the next alert - as long as it is still its task's last report.
#
# Invoked by internal/handler/import.go via `sudo` when GVM's HTTP-Get alert
# pings GET /api/import/openvas. Runs as root so it can traverse /var/lib/docker.

import fcntl
import http.client
import json
import os
import re
import socket
import sys
import urllib.parse

ENV_FILE = os.environ.get("OT_ENV_FILE", "/etc/openvas-tracker/env")
GMP_SOCKET = os.environ.get(
    "OT_GMP_SOCKET",
    "/var/lib/docker/volumes/greenbone-community-edition_gvmd_socket_vol/_data/gvmd.sock",
)
TRACKER_HOST = os.environ.get("OT_TRACKER_HOST", "127.0.0.1")
TRACKER_PORT = int(os.environ.get("OT_TRACKER_PORT", "8080"))
# Serializes runs: a second alert waits, then finds the reports already imported.
LOCK_FILE = "/run/openvas-tracker-fetch.lock"


def load_env(path):
    env = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def gmp_call(sock, xml_bytes, resp_tag):
    # Reads one GMP response element named resp_tag (e.g. "authenticate_response").
    # Completes on the closing tag </resp_tag>, on a self-closing root <resp_tag .../>,
    # or on EOF. The self-closing case matters: gvmd answers errors such as a failed
    # authentication with <authenticate_response status="400" .../> and then keeps the
    # socket OPEN — waiting only for a "</resp_tag>" that never arrives would block until
    # the socket timeout (observed: a wrong OT_GMP_PASSWORD hung the import for 10 min).
    sock.sendall(xml_bytes)
    buf = bytearray()
    open_tag = ("<" + resp_tag).encode()
    close_tag = ("</" + resp_tag + ">").encode()
    while True:
        if close_tag in buf:
            break
        start = buf.find(open_tag)
        if start != -1:
            gt = buf.find(b">", start)
            if gt != -1 and buf[gt - 1:gt] == b"/":
                break  # self-closing root element -> response already complete
        chunk = sock.recv(1 << 16)
        if not chunk:
            if buf:
                break  # gvmd closed the socket; return whatever we got
            raise RuntimeError(f"GMP socket closed before <{resp_tag}> response")
        buf.extend(chunk)
    return bytes(buf)


def xml_escape(s):
    return (
        s.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def finished_reports(get_tasks_xml):
    """(scan_end, report_id, scan_start) of every task's last finished report, oldest first."""
    out = []
    task_re = re.compile(rb"<task id=\"[0-9a-f-]{36}\"[^>]*>(.*?)</task>", re.DOTALL)
    lr_re = re.compile(
        rb"<last_report>\s*<report id=\"([0-9a-f-]{36})\"[^>]*>(.*?)</report>", re.DOTALL
    )
    for tm in task_re.finditer(get_tasks_xml):
        m = lr_re.search(tm.group(1))
        if not m:
            continue
        rid = m.group(1).decode()
        end = re.search(rb"<scan_end>([^<]+)</scan_end>", m.group(2))
        start = re.search(rb"<scan_start>([^<]+)</scan_start>", m.group(2))
        if not end:
            print(f"warning: report {rid} has no scan_end, skipped", file=sys.stderr)
            continue
        out.append((end.group(1).decode(), rid, start.group(1).decode() if start else ""))
    return sorted(out)  # gvmd writes uniform ISO-8601 UTC, so string order is time order


def gmp_connect(user, password):
    sock = socket.socket(socket.AF_UNIX)
    sock.settimeout(600)
    try:
        sock.connect(GMP_SOCKET)
    except OSError as e:
        sys.exit(f"cannot connect to GMP socket {GMP_SOCKET}: {e}")
    auth = (
        f"<authenticate><credentials>"
        f"<username>{xml_escape(user)}</username>"
        f"<password>{xml_escape(password)}</password>"
        f"</credentials></authenticate>"
    ).encode()
    resp = gmp_call(sock, auth, "authenticate_response")
    if b'status="200"' not in resp:
        sock.close()
        sys.exit(
            "GMP authenticate failed (check OT_GMP_USER/OT_GMP_PASSWORD in "
            + ENV_FILE
            + "): "
            + resp.decode(errors="replace")
        )
    return sock


def tracker(method, path, api_key, body=None, timeout=60):
    headers = {"X-API-Key": api_key}
    if body is not None:
        headers["Content-Type"] = "application/xml"
    conn = http.client.HTTPConnection(TRACKER_HOST, TRACKER_PORT, timeout=timeout)
    try:
        conn.request(method, path, body=body, headers=headers)
        r = conn.getresponse()
        return r.status, r.read().decode(errors="replace")
    finally:
        conn.close()


def main():
    env = load_env(ENV_FILE)
    user = env.get("OT_GMP_USER", "admin")
    password = env.get("OT_GMP_PASSWORD", "")
    api_key = env.get("OT_IMPORT_APIKEY", "")
    if not password:
        sys.exit("missing OT_GMP_PASSWORD in " + ENV_FILE)
    if not api_key:
        sys.exit("missing OT_IMPORT_APIKEY in " + ENV_FILE)

    lock = open(LOCK_FILE, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    feeds_xml = b""
    sock = gmp_connect(user, password)
    try:
        tasks_resp = gmp_call(
            sock,
            b'<get_tasks filter="rows=-1" usage_type="scan"/>',
            "get_tasks_response",
        )
        # Feed versions (best-effort — must never fail the scan import).
        try:
            feeds_xml = gmp_call(sock, b"<get_feeds/>", "get_feeds_response")
        except Exception as e:
            print("warning: get_feeds failed: %s" % e, file=sys.stderr)
    finally:
        sock.close()

    reports = finished_reports(tasks_resp)
    if not reports:
        print("no task with a finished report found in GVM")

    for scan_end, report_id, scan_start in reports:
        query = urllib.parse.urlencode(
            {"report_id": report_id, "scan_start": scan_start, "scan_end": scan_end}
        )
        status, body = tracker("GET", "/api/import/openvas/check?" + query, api_key)
        if status != 200:
            sys.exit(f"tracker check {status}: {body}")
        verdict = json.loads(body)
        if not verdict.get("import"):
            print(f"skipped report {report_id} ({scan_end}): {verdict.get('reason')}")
            continue

        # NB: no format_id — gvmd's native response already is XML in the
        # <get_reports_response><report><report>...</report></report></get_reports_response>
        # envelope that internal/scanner/openvas.go expects. Passing the XML
        # format_id instead goes through a report format plugin that is slow
        # or broken in current Greenbone CE builds.
        sock = gmp_connect(user, password)
        try:
            full = gmp_call(
                sock,
                f'<get_reports report_id="{report_id}" details="1" '
                f'ignore_pagination="1"/>'.encode(),
                "get_reports_response",
            )
        finally:
            sock.close()
        if b'status="200"' not in full[:200]:
            sys.exit("GMP get_reports failed: " + full[:500].decode(errors="replace"))

        status, body = tracker("POST", "/api/import/openvas", api_key, full, timeout=3600)
        if status == 409:
            print(f"report {report_id} ({scan_end}) already imported")
        elif status == 400:
            # Permanent rejection (e.g. no results): retrying won't help, don't block newer reports.
            print(f"warning: tracker rejected report {report_id}: {body}", file=sys.stderr)
        elif status >= 300:
            # Stop here: importing a newer report would move the cutoff past this one.
            sys.exit(f"tracker import POST {status}: {body}")
        else:
            print(f"imported report {report_id} ({scan_end}): {status} {body}")

    if feeds_xml:
        try:
            status, body = tracker("POST", "/api/import/feeds", api_key, feeds_xml)
            print(f"feeds updated: {status} {body}")
        except Exception as e:
            print("warning: feeds post failed: %s" % e, file=sys.stderr)


if __name__ == "__main__":
    main()
