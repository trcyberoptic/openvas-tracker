OT_SERVER_HOST=0.0.0.0
OT_SERVER_PORT=8080
OT_DATABASE_DSN=openvas-tracker:openvas-tracker@tcp(localhost:3306)/openvas-tracker?parseTime=true
OT_DATABASE_MAXCONNS=25
OT_DATABASE_MINCONNS=5
OT_JWT_SECRET=change-me-in-production
OT_JWT_EXPIREHOURS=24
# Import webhook key — min 32 chars; if empty, all /api/import endpoints are disabled
OT_IMPORT_APIKEY=
# Admin login (username: admin)
OT_ADMIN_PASSWORD=
# Consecutive scan misses before a ticket auto-resolves
OT_AUTORESOLVE_THRESHOLD=3
# Optional: LDAP / Active Directory
#OT_LDAP_URL=ldaps://dc01.example.com:636
#OT_LDAP_BASE_DN=DC=example,DC=com
#OT_LDAP_BIND_DN=CN=svc-tracker,OU=Service,DC=example,DC=com
#OT_LDAP_BIND_PASSWORD=
#OT_LDAP_GROUP_DN=CN=vuln-mgmt,OU=Groups,DC=example,DC=com
#OT_LDAP_USER_FILTER=(sAMAccountName=%s)
# Skip TLS cert verification for ldaps:// (internal CA)
#OT_LDAP_INSECURE_SKIP_VERIFY=false
# Optional: bug-report widget URL (origin is whitelisted in CSP at startup)
#OT_BUGREPORT_URL=
# Used by the GMP fetch script (deploy/openvas-tracker-fetch-latest), not the app itself
#OT_GMP_USER=admin
#OT_GMP_PASSWORD=
